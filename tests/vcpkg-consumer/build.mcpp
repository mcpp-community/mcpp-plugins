// The whole integration: which libraries to link. The installation, the
// include directory and the runtime library directory follow from the manifest.
import std;
import mcpp;
import mcpp.deps.vcpkg;

int main() {
    mcpp::deps::vcpkg::options o;
    o.libraries = { "fmt" };
    // This fixture lives inside the package it depends on by path, and mcpp keys
    // that package's host tool by a stamp of its tree, `target/` excepted
    // (mcpp#705). An installation beside the manifest would change the stamp,
    // rebuild `mcpp-deps` and run again, so it goes under `target/`. A project
    // that takes `mcpp:plugins` from the index keeps vcpkg's default.
    o.install_root = "target/vcpkg_installed";
    return mcpp::deps::vcpkg::use(o) ? 0 : 1;
}
