// The whole integration: which libraries to link. The installation, the
// include directory and the runtime library directory follow from the manifest.
import std;
import mcpp;
import mcpp.deps.vcpkg;

int main() {
    mcpp::deps::vcpkg::options o;
    o.libraries = { "fmt" };
    // This fixture lives inside the package it depends on by path, so its
    // installation goes under `target/`, which `git clean` and the CI's
    // `rm -rf target` reset with the rest of the fixture. A project keeps
    // vcpkg's default.
    o.install_root = "target/vcpkg_installed";
    // A file the program would read at run time, placed beside it.
    o.deploy = {{"share/fmt/copyright", "licenses/fmt"}};
    return mcpp::deps::vcpkg::use(o) ? 0 : 1;
}
