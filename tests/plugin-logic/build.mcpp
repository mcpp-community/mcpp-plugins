// The deps members' decisions, the files rules-qt reads by default, and what
// a platform's plugin states (mcpp.plugins.platform, the package reader), one
// case per decision (mcpp#734, design §6; mcpp SPEC-013 §12, SPEC-014 §4.5).
// Each case states a build context, runs the member, and reads the action it
// declared and the files it wrote. Nothing is installed or run.
import std;
import mcpp;
import mcpp.plugins.testing;
import mcpp.plugins.toolset;
import mcpp.deps;          // the 0.16.0 names, for the compatibility case
import mcpp.deps.vcpkg;
import mcpp.deps.cmake;
import mcpp.rules.qt;
import mcpp.rules.qml;
import mcpp.plugins.tool;
import mcpp.plugins.platform;
import mcpp.plugins;
import mcpp.plugins.accel;
import mcpp.plugins.progress;
import mcpp.plugins.progress.writer;
import mcpp.rules.cuda;
import mcpp.rules.sycl;
import mcpp.rules.hip;
import mcpp.rules.spirv;

namespace t  = mcpp::plugins::testing;
namespace ts = mcpp::plugins::toolset;
namespace pf = mcpp::plugins::platform;

namespace {

// A vcpkg root with the three standard triplets the cases use, and a manifest.
t::context with_vcpkg(t::context c) {
    const bool win = std::string_view(c.values.front().second).find("windows") != std::string_view::npos;
    return c.xpkg("xim", "vcpkg", "{root}/vcpkg")
        .file(win ? "vcpkg/vcpkg.exe" : "vcpkg/vcpkg")
        .file("vcpkg/triplets/x64-windows.cmake",
              "set(VCPKG_TARGET_ARCHITECTURE x64)\nset(VCPKG_CRT_LINKAGE dynamic)\nset(VCPKG_LIBRARY_LINKAGE dynamic)\n")
        .file("vcpkg/triplets/x64-windows-static.cmake",
              "set(VCPKG_TARGET_ARCHITECTURE x64)\nset(VCPKG_CRT_LINKAGE static)\nset(VCPKG_LIBRARY_LINKAGE static)\n")
        .file("vcpkg/triplets/x64-linux.cmake",
              "set(VCPKG_TARGET_ARCHITECTURE x64)\nset(VCPKG_CRT_LINKAGE dynamic)\nset(VCPKG_LIBRARY_LINKAGE static)\n"
              "set(VCPKG_CMAKE_SYSTEM_NAME Linux)\n")
        .file("pkg/vcpkg.json", "{ \"dependencies\": [\"fmt\"] }\n");
}

t::context with_subproject(t::context c) {
    return c.xpkg("xim", "cmake", "{root}/cmake")
        .file("cmake/bin/cmake").file("cmake/bin/cmake.exe")
        .file("pkg/greet/CMakeLists.txt", "project(greet C)\n");
}

// Output directories of other build systems inside a tree `at`: an MSBuild
// intermediate directory, a CMake build directory, a tagged cache directory and
// one whose tag lacks the signature. `x64/` itself is a directory of sources.
t::context with_foreign_output(t::context c, const std::string& at, const std::string& ext) {
    return c.file(at + "/x64/simd" + ext, "class Simd { Q_OBJECT };\n")
        .file(at + "/x64/Release/app.tlog/app.lastbuildstate")
        .file(at + "/x64/Release/qt/uic/ui_form" + ext, "class Ui { Q_OBJECT };\n")
        .file(at + "/cmake-build-debug/CMakeCache.txt")
        .file(at + "/cmake-build-debug/gen/stale" + ext, "class Stale { Q_OBJECT };\n")
        .file(at + "/cache/CACHEDIR.TAG", "Signature: 8a477f597d28d172789f06886806bc55\n")
        .file(at + "/cache/blob" + ext)
        .file(at + "/notag/CACHEDIR.TAG", "not a tag\n")
        .file(at + "/notag/kept" + ext);
}

// A stand-in Qt SDK: the tools rules-qt looks for, never run.
t::context with_qt(t::context c) {
    for (auto const* tool : { "moc", "lupdate", "lrelease" })
        c = c.file(std::string("qt/bin/") + tool).file(std::string("qt/bin/") + tool + ".exe");
    return c.file("pkg/widget.h", "class Widget { Q_OBJECT };\n").file("pkg/app.ts");
}

int vcpkg_use(mcpp::deps::vcpkg::options o = {}) {
    o.libraries = {"fmt"};
    return mcpp::deps::vcpkg::use(o) ? 0 : 1;
}

int cmake_use(mcpp::deps::cmake::options o = {}) {
    o.source = "greet";
    o.libraries = {"greet"};
    return mcpp::deps::cmake::use(o) ? 0 : 1;
}

// The one generated triplet of a case, by file name.
std::string derived_triplet(const t::result& r) {
    for (auto const& f : r.files_under("out/deps-vcpkg/triplets"))
        if (f.find("-mcpp-") != std::string::npos) return f;
    return {};
}

// A universal package's metadata as `mcpp pack` writes it (SPEC-014 §4.5).
constexpr std::string_view kPackage = R"({
  "schema": 1,
  "name": "hello",
  "version": "0.1.0",
  "platform": "openkal-platform@0.17.2",
  "linkage": "declared",
  "mode": "vendored",
  "legs": ["x86_64-openkal", "aarch64-openkal"],
  "systems": [],
  "launch": {
    "entry": { "aarch64": "lib/aarch64/hello.oke", "x86_64": "lib/x86_64/hello.oke" },
    "runner": ["okrun", "{}"]
  },
  "files": [
    { "leg": null, "path": "bin/hello", "role": "launcher", "sha256": "aa" },
    { "leg": "aarch64-openkal", "path": "lib/aarch64/hello.oke", "role": "image", "sha256": "bb" },
    { "leg": "x86_64-openkal", "path": "lib/x86_64/hello.oke", "role": "image", "sha256": "cc" },
    { "leg": null, "path": "share/data.txt", "role": "resource", "sha256": "dd" }
  ]
}
)";

t::context with_stage(t::context c, std::string_view doc = kPackage) {
    return c.file("stage/hello-0.1.0-openkal/mcpp-package.json", std::string(doc))
        .set("MCPP_PACK_STAGE_DIR", "{root}/stage/hello-0.1.0-openkal");
}

// The format a case provides: `okb`, its command the stage and the entry.
int provide_okb() {
    auto r = pf::provide_format("okb", [](const mcpp::plugins::package::info& p, mcpp::action& a) {
        static std::string out;
        out = p.name + "-" + p.version + ".okb";
        a.arg("okld").arg("bundle").arg(out.c_str()).arg("--package").arg("${mcpp.stage_dir}")
         .output(out.c_str());
        return true;
    });
    return r ? 0 : 1;
}

std::string stem(const std::string& path) {
    return std::filesystem::path(path).stem().string();
}

// The derived triplet's name under two different roots: equal names mean the
// name, and the text it is hashed from, hold no path (design §6.6).
std::string first_linux_name;

// The resolver under the `deps-cmake` spec, which every case above shares.
mcpp::plugins::tool::found tool_resolve(mcpp::plugins::tool::choice c = {}) {
    return mcpp::plugins::tool::resolve(mcpp::deps::cmake_spec("mcpp.deps.cmake"), c);
}


// A stand-in SDK with every tool rules-qt runs and one plugin directory.
t::context with_full_qt(t::context c) {
    for (auto const* tool : { "moc", "uic", "rcc", "lupdate", "lrelease", "lconvert" })
        c = c.file(std::string("qt/bin/") + tool);
    return c.file("qt/lib/libQt6Core.so").file("qt/include/QtCore/qobject.h")
        .file("qt/plugins/platforms/libqxcb.so")
        .file("pkg/widget.h", "class Widget { Q_OBJECT };\n")
        .file("pkg/form.ui").file("pkg/res/app.qrc", "<RCC><qresource prefix=\"/\"></qresource></RCC>\n")
        .file("pkg/app.ts");
}

// What a case printed that the engine would read: the directives, with the
// case's own directory replaced, so one text serves every host.
std::string directives(const t::result& r) {
    std::string out;
    const std::string root = r.root.generic_string();
    for (auto const& l : r.lines) {
        if (!l.starts_with("mcpp:") || l.starts_with("mcpp:decision=") || l.starts_with("mcpp:fact=mcpp.plugins=")
            || l.starts_with("mcpp:protocol=")) continue;
        std::string x = l;
        for (std::size_t at = x.find(root); at != std::string::npos; at = x.find(root, at + 6)) x.replace(at, root.size(), "<R>");
        out += x + "\n";
    }
    return out;
}


// ─── rules-qml: a stand-in SDK and the package it builds ────────────────────

// The SDK of a QML program: every tool rules-qml runs, two linked modules, and a
// tree of QML modules whose `qmldir` files and `.qml` files import one another
// the way Qt's do.
t::context with_qml_sdk(t::context c, bool with_qsb = true) {
    for (auto const* tool : { "moc", "rcc", "qmltyperegistrar", "qmlcachegen" }) c = c.file(std::string("qt/libexec/") + tool);
    c = c.file("qt/bin/qmllint");
    if (with_qsb) c = c.file("qt/bin/qsb");
    c = c.file("qt/lib/libQt6Core.so").file("qt/lib/libQt6Qml.so")
         .file("qt/include/QtCore/qobject.h").file("qt/include/QtQml/qqmlregistration.h")
         .file("qt/metatypes/qt6core_metatypes.json").file("qt/metatypes/qt6qml_metatypes.json")
         .file("qt/plugins/platforms/libqoffscreen.so")
         .file("qt/plugins/imageformats/libqpng.so");
    return c
        .file("qt/qml/QtQuick/qmldir", "module QtQuick\nplugin qtquick2plugin\nimport QtQml\ndepends QtQml.Models 2.0\n")
        .file("qt/qml/QtQuick/libqtquick2plugin.so")
        .file("qt/qml/QtQuick/plugins.qmltypes", "Module {}\n")
        .file("qt/qml/QtQuick/designer/Hidden.qml", "import QtQuick.Templates\nItem {}\n")
        .file("qt/qml/QtQml/qmldir", "module QtQml\n")
        .file("qt/qml/QtQml/Models/qmldir", "module QtQml.Models\n")
        .file("qt/qml/QtQuick/Controls/qmldir",
              "module QtQuick.Controls\ndefault import QtQuick.Controls.Basic\n"
              "optional import QtQuick.Controls.Material auto\noptional import QtQuick.Controls.Fusion auto\n"
              "import QtQuick.Templates\n")
        .file("qt/qml/QtQuick/Controls/Button.qml", "import QtQuick\nItem {}\n")
        .file("qt/qml/QtQuick/Controls/Basic/qmldir", "module QtQuick.Controls.Basic\n")
        .file("qt/qml/QtQuick/Controls/Material/qmldir", "module QtQuick.Controls.Material\n")
        .file("qt/qml/QtQuick/Controls/Material/Button.qml",
              "import QtQuick.Templates as T // a comment: import NotAModule\nimport QtQuick.Controls.Material.impl;\nItem {}\n")
        .file("qt/qml/QtQuick/Controls/Material/impl/qmldir", "module QtQuick.Controls.Material.impl\n")
        .file("qt/qml/QtQuick/Controls/Material/impl/Ripple.qml", "import QtQuick\nimport QtQuick.Controls.Material\nItem {}\n")
        .file("qt/qml/QtQuick/Controls/Fusion/qmldir", "module QtQuick.Controls.Fusion\n")
        .file("qt/qml/QtQuick/Templates/qmldir", "module QtQuick.Templates\n");
}

// The `mcpp:deploy=` directives of a case, as `<to>/<file name>`.
std::set<std::string> deployed(const t::result& r) {
    std::set<std::string> out;
    for (auto const& l : r.lines) {
        if (!l.starts_with("mcpp:deploy=")) continue;
        const auto tab = l.find('\t');
        const std::string file = l.substr(12, tab - 12), to = l.substr(tab + 1);
        out.insert(to + "/" + file.substr(file.rfind('/') + 1));
    }
    return out;
}

// The action a case declared, by the start of its id, as JSON text.
std::string action_of(const t::result& r, const std::string& id) {
    return r.line("mcpp:action=", {"\"id\":\"" + id});
}

bool mentions(const std::string& text, const std::string& part) { return text.find(part) != std::string::npos; }

// A package with one module `Probe`: two QML types (one a singleton), a script, a
// nested file, a resource whose name needs XML escaping, and a header with a QML type.
t::context with_probe(t::context c) {
    return c.file("pkg/qml/Probe/Main.qml", "import QtQuick\nimport QtQuick.Controls\nItem { }\n")
        .file("pkg/qml/Probe/Style.qml", "pragma Singleton\nimport QtQuick\nQtObject { }\n")
        .file("pkg/qml/Probe/helper.qml", "import QtQuick\nItem { }\n")
        .file("pkg/qml/Probe/util.js", ".pragma library\nfunction f() {}\n")
        .file("pkg/qml/Probe/sub/Inner.qml", "import QtQuick\nQtObject { }\n")
        .file("pkg/qml/Probe/data/a&b.txt", "resource\n")
        .file("pkg/src/thing.h", "#include <QtQml/qqmlregistration.h>\nclass Thing : public QObject { Q_OBJECT QML_ELEMENT };\n");
}

// A resource whose name has `<` and `>`, which XML must escape and a Windows host
// cannot create: made where it can be, and said.
void make_odd_resource() {
    std::error_code ec;
    const auto file = std::filesystem::path(mcpp::manifest_dir()) / "qml/Probe/data/c<d>.txt";
    std::ofstream(file) << "resource\n";
    std::printf("odd=%d\n", std::filesystem::exists(file, ec));
}

mcpp::rules::qml::options probe_options() {
    mcpp::rules::qml::options o;
    o.qt.root = "../qt";
    o.qt.modules = {"Core"};
    o.qt.deploy_plugins = {"platforms"};
    mcpp::rules::qml::qml_module m;
    m.uri = "Probe";
    m.version = "1.2";
    m.root = "qml/Probe";
    m.sources = {"qml/Probe/**/*.qml", "qml/Probe/**/*.js"};
    m.resources = {"qml/Probe/data/*"};
    o.modules = {m};
    return o;
}

} // namespace

int main(int argc, char** argv) {
    return t::run(argc, argv, {
        { "surface: equal-size payload changes reach assembly and identical bytes keep its timestamp",
          t::row::linux_gcc().file("pkg/payload.bin", "abcd"),
          [] {
              namespace sf = mcpp::plugins::surface;
              const auto root=std::filesystem::path(mcpp::manifest_dir());
              sf::options options;
              options.module_name="fixture.embed";
              options.out_dir=mcpp::out_dir();
              options.store=sf::storage::object;
              options.target_os="linux";
              options.has_gas_assembler=true;
              const std::vector<sf::item> items{{.identifier="data",.payload_path=(root/"payload.bin").string()}};
              if (!sf::write(items,options,sf::half::body)) return 1;
              const auto file=sf::outputs(options).assembly_file;
              auto read=[&]{std::ifstream in(file);return std::string(std::istreambuf_iterator<char>(in),{});};
              const auto before=read();
              std::ofstream(root/"payload.bin",std::ios::binary|std::ios::trunc)<<"abce";
              if (!sf::write(items,options,sf::half::body) || read()==before) return 2;
              const auto sentinel=std::filesystem::file_time_type::clock::now()-std::chrono::hours(1);
              std::filesystem::last_write_time(file,sentinel);
              if (!sf::write(items,options,sf::half::body)) return 3;
              return std::filesystem::last_write_time(file)==sentinel ? 0 : 4;
          },
          [](const t::result& r,t::checker& c){c.expect(r.exit_code==0,"the body tracks payload content without rewriting unchanged source");} },

        { "progress: no channel leaves work independent of telemetry",
          t::row::linux_gcc(),
          [] {
              mcpp::plugins::progress::writer writer;
              return !writer.enabled() && !writer.report({.phase="configure"}) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) { c.expect(r.exit_code == 0, "absence is a no-op"); } },
        { "progress: snapshots replace atomically and publishing is rate limited",
          t::row::linux_gcc().set("MCPP_ACTION_PROGRESS_FILE", "{root}/telemetry/state.json")
              .file("telemetry/keep"),
          [] {
              mcpp::plugins::progress::writer writer;
              if (!writer.enabled() || !writer.report({.phase="configure"})) return 1;
              if (writer.report({.phase="too-soon"})) return 2;
              std::this_thread::sleep_for(std::chrono::milliseconds(210));
              return writer.report({.phase="build",.done=3,.total=9}) ? 0 : 3;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "two bounded reports succeeded");
              const auto text=r.file("telemetry/state.json");
              c.expect(text.find("\"seq\":1") != std::string::npos
                  && text.find("\"phase\":\"build\"") != std::string::npos
                  && text.find("configure") == std::string::npos, "only the latest snapshot remains");
          } },
        { "progress: invalid counts and terminal controls are refused",
          t::row::linux_gcc().set("MCPP_ACTION_PROGRESS_FILE", "{root}/telemetry/state.json")
              .file("telemetry/keep"),
          [] {
              mcpp::plugins::progress::writer writer;
              return !writer.report({.phase="bad\nphase"})
                  && !writer.report({.phase="build",.done=4,.total=3}) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "invalid optional data was refused");
              c.expect(r.file("telemetry/state.json").empty(), "invalid telemetry wrote no document");
          } },

        { "accel: targets stay on their implementation across internal commas",
          t::row::linux_gcc(),
          [] {
              const auto parsed = mcpp::plugins::accel::parse(
                  "sycl+{spir64,nvptx64-sm_90,nvptx64-sm_89},cuda12.9+{sm_90,sm_89}");
              return parsed && parsed->size() == 2 && (*parsed)[0].backend == "cuda"
                  && (*parsed)[0].archs.size() == 2 && (*parsed)[1].backend == "sycl"
                  && (*parsed)[1].archs.size() == 3 ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) { c.expect(r.exit_code == 0, "member ownership survives set commas"); } },

        { "accel: implementation membership is exact rather than a prefix",
          t::row::linux_gcc(),
          [] {
              const char* text = "cudaextra+{x},syclish+{y},hipster+{z},vulkanother1.0";
              return !mcpp::rules::cuda::parse_target(text).present
                  && !mcpp::rules::sycl::parse_target(text).sycl
                  && !mcpp::rules::hip::parse_target(text).hip
                  && !mcpp::rules::spirv::parse_target(text).present ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) { c.expect(r.exit_code == 0, "no rule takes another implementation's prefix"); } },

        { "sycl: multiple NVIDIA targets do not select a CUDA implementation",
          t::row::linux_gcc(),
          [] {
              const auto a = mcpp::rules::sycl::parse_target("sycl+{nvptx64-sm_90,nvptx64-sm_89}");
              return a.error.empty() && a.sycl && !a.portable && !a.legacy_targets
                  && a.cuda_archs == std::vector<std::string>{"sm_89", "sm_90"}
                  && !mcpp::rules::cuda::parse_target("sycl+{nvptx64-sm_90,nvptx64-sm_89}").present ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) { c.expect(r.exit_code == 0, "the NVIDIA target belongs to SYCL"); } },

        { "sycl: generic and NVIDIA forms coexist in one request",
          t::row::linux_gcc(),
          [] {
              const auto a = mcpp::rules::sycl::parse_target("sycl+{spir64,nvptx64-sm_89}");
              return a.error.empty() && a.portable && a.cuda_archs.size() == 1 ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) { c.expect(r.exit_code == 0, "both forms are preserved"); } },

        { "sycl: explicit targets are not replaced by a coexisting CUDA request",
          t::row::linux_gcc(),
          [] {
              const auto a = mcpp::rules::sycl::parse_target("cuda12.9+{sm_90},sycl+{nvptx64-sm_89}");
              return a.error.empty() && !a.legacy_targets
                  && a.cuda_archs == std::vector<std::string>{"sm_89"} ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) { c.expect(r.exit_code == 0, "each implementation keeps its targets"); } },

        { "sycl: the old explicit two-member spelling retains its migration boundary",
          t::row::linux_gcc(),
          [] {
              const auto a = mcpp::rules::sycl::parse_target("sycl,cuda12.9+{sm_89,sm_90}");
              return a.error.empty() && a.legacy_targets && a.cuda_archs.size() == 2
                  && mcpp::rules::cuda::parse_target("sycl,cuda12.9+{sm_89,sm_90}").present ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) { c.expect(r.exit_code == 0, "CUDA remains selected in the legacy spelling"); } },

        { "sycl: an unknown target is refused instead of defaulting to SPIR-V",
          t::row::linux_gcc(),
          [] { return mcpp::rules::sycl::parse_target("sycl+{unknown-device}").error.empty() ? 1 : 0; },
          [](const t::result& r, t::checker& c) { c.expect(r.exit_code == 0, "unknown target has a diagnostic"); } },

        { "hip: AMD target sets retain all targets",
          t::row::linux_gcc(),
          [] {
              const auto a = mcpp::rules::hip::parse_target("hip6.4+{gfx942,gfx1100}");
              return a.error.empty() && a.hip && a.amd_archs.size() == 2 ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) { c.expect(r.exit_code == 0, "HIP does not split the set into members"); } },

        { "accel: malformed and duplicate requests are diagnosed before a rule can no-op",
          t::row::linux_gcc(),
          [] {
              for (auto text : {"sycl+{sm_89", "sycl+{sm_89}junk", "sycl+{a,,b}", "sycl,sycl"})
                  if (mcpp::plugins::accel::parse(text)) return 1;
              return 0;
          },
          [](const t::result& r, t::checker& c) { c.expect(r.exit_code == 0, "all malformed requests have an error"); } },

        // ── deps-vcpkg ──────────────────────────────────────────────────────
        { "vcpkg: a Visual Studio toolset is selected through its instance",
          with_vcpkg(t::row::windows_visual_studio()),
          [] { return vcpkg_use(); },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              const auto a = r.line("mcpp:action=", {"deps-vcpkg:install:x64-windows\""});
              c.expect(!a.empty(), "the installation uses the standard triplet x64-windows");
              c.expect(a.find("VCPKG_VISUAL_STUDIO_PATH=") != std::string::npos,
                       "the action selects the instance with VCPKG_VISUAL_STUDIO_PATH");
              c.expect(a.find("--host-triplet") == std::string::npos, "the host triplet stays vcpkg's");
              c.expect(derived_triplet(r).empty(), "no triplet is derived");
          } },

        { "vcpkg: another toolset version of the instance derives a triplet that names it",
          with_vcpkg(t::row::windows_visual_studio("14.43.34808", "14.44.35207")),
          [] { return vcpkg_use(); },
          [](const t::result& r, t::checker& c) {
              const auto f = derived_triplet(r);
              c.expect(!f.empty(), "a triplet x64-windows-mcpp-<hash> is derived");
              c.expect(r.file(f).find("set(VCPKG_PLATFORM_TOOLSET_VERSION 14.43.34808)") != std::string::npos,
                       "the derived triplet names the resolved toolset version");
              c.expect(r.file(f).find("VCPKG_CHAINLOAD_TOOLCHAIN_FILE") == std::string::npos,
                       "the instance's own loading stays in place");
              c.expect(r.has_line("mcpp:action=", {"VCPKG_VISUAL_STUDIO_PATH="}),
                       "the action still selects the instance");
          } },

        { "vcpkg: a managed toolset is named in a chain-loaded derived triplet",
          with_vcpkg(t::row::windows_managed()),
          [] { return vcpkg_use(); },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              const auto f = derived_triplet(r);
              const auto name = stem(f);
              c.expect(name.starts_with("x64-windows-mcpp-"), "the derived triplet is x64-windows-mcpp-<hash>");
              const auto text = r.file(f);
              c.expect(text.find("set(VCPKG_LIBRARY_LINKAGE dynamic)") != std::string::npos,
                       "the base triplet is inlined, not included");
              c.expect(text.find("\"${CMAKE_CURRENT_LIST_DIR}/mcpp-chain-windows.cmake\"") != std::string::npos,
                       "the chain-loaded toolchain is found beside the triplet");
              c.expect(text.find("MCPP_VCPKG_CXX") != std::string::npos && text.find(" INCLUDE") != std::string::npos
                       && text.find(" LIB") != std::string::npos,
                       "the tools and their environment pass through untracked");
              c.expect(text.find("# toolset: msvc 14.44.35207; sdk 10.0.26100.0 (chain)") != std::string::npos,
                       "the triplet carries the toolset's identity");
              c.expect(text.find("variable_watch(VCPKG_PLATFORM_TOOLSET") != std::string::npos,
                       "an MSBuild port is refused by name");
              c.expect(text.find(r.root.generic_string()) == std::string::npos, "the triplet holds no path");
              const auto chain = r.file("out/deps-vcpkg/triplets/mcpp-chain-windows.cmake");
              c.expect(chain.find("file(TO_CMAKE_PATH \"$ENV{MCPP_VCPKG_CXX}\"") != std::string::npos,
                       "the toolchain reads each tool from the environment through TO_CMAKE_PATH");
              c.expect(chain.find("/scripts/toolchains/windows.cmake\")") != std::string::npos,
                       "the toolchain includes vcpkg's windows.cmake");
              c.expect(chain.find(r.root.generic_string()) == std::string::npos, "the toolchain holds no path");
              const auto a = r.line("mcpp:action=", {"deps-vcpkg:install:" + name});
              c.expect(!a.empty(), "the installation uses the derived triplet");
              c.expect(a.find("\"--host-triplet=" + name + "\"") != std::string::npos,
                       "the host triplet is the derived one");
              c.expect(a.find("\"VCPKG_KEEP_ENV_VARS=PATH\"") != std::string::npos,
                       "vcpkg keeps the PATH the action sets");
              c.expect(a.find("\"PATH=") != std::string::npos && a.find("Hostx64") != std::string::npos,
                       "the toolset's directories are on that PATH");
              c.expect(a.find("VCPKG_VISUAL_STUDIO_PATH") == std::string::npos, "no instance is selected");
          } },

        { "vcpkg: a self-contained program's ports link the C runtime statically",
          with_vcpkg(t::row::windows_managed()
                         .set("MCPP_CXX_RUNTIME", "self-contained").set("MCPP_MSVC_CRT_LINKAGE", "static")),
          [] { return vcpkg_use(); },
          [](const t::result& r, t::checker& c) {
              const auto f = derived_triplet(r);
              c.expect(stem(f).starts_with("x64-windows-static-mcpp-"), "the base triplet is x64-windows-static");
              c.expect(r.file(f).find("set(VCPKG_CRT_LINKAGE static)") != std::string::npos,
                       "the derived triplet states the static C runtime");
          } },

        { "vcpkg: a project triplet that contradicts the program's C runtime is refused",
          with_vcpkg(t::row::windows_visual_studio()
                         .set("MCPP_CXX_RUNTIME", "self-contained").set("MCPP_MSVC_CRT_LINKAGE", "static")),
          [] { return vcpkg_use({.triplet = "x64-windows"}); },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code != 0, "the member fails");
              c.expect(r.errors.find("the triplet 'x64-windows' links the C runtime dynamic") != std::string::npos
                       && r.errors.find("links it static (the program's C++ runtime contract, self-contained)")
                              != std::string::npos,
                       "the error names both statements");
              c.expect(r.count("mcpp:action=") == 0, "nothing is installed");
          } },

        { "vcpkg: crt_linkage states the ports' linkage and wins over the contract",
          with_vcpkg(t::row::windows_visual_studio()
                         .set("MCPP_CXX_RUNTIME", "self-contained").set("MCPP_MSVC_CRT_LINKAGE", "static")),
          [] { return vcpkg_use({.triplet = "x64-windows", .crt_linkage = "dynamic"}); },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              c.expect(r.has_line("mcpp:action=", {"deps-vcpkg:install:x64-windows\""}),
                       "the project's triplet is used");
          } },

        { "vcpkg: detected leaves the toolset to vcpkg and says until when",
          with_vcpkg(t::row::windows_visual_studio()),
          [] { return vcpkg_use({.toolset = {.toolset = ts::source::detected}}); },
          [](const t::result& r, t::checker& c) {
              c.expect(r.has_line("mcpp:action=", {"deps-vcpkg:install:x64-windows\""}),
                       "the standard triplet is used");
              c.expect(!r.has_line("mcpp:action=", {"VCPKG_VISUAL_STUDIO_PATH"}), "no instance is selected");
              c.expect(r.has_line("mcpp:diagnostic=note", {"kept until 2027-03-28"}),
                       "the compatibility note is printed");
          } },

        { "vcpkg: the Linux GCC row keeps vcpkg's detection, and says why",
          with_vcpkg(t::row::linux_gcc()),
          [] {
              const auto r = ts::resolve();
              std::printf("reason=%s\n", r ? r->reason.c_str() : "");
              return vcpkg_use();
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.has_line("mcpp:action=", {"deps-vcpkg:install:x64-linux\""}),
                       "the standard triplet x64-linux is used");
              c.expect(!r.has_line("mcpp:action=", {"MCPP_VCPKG_CXX="}), "no compiler is named");
              c.expect(r.has_line("reason=", {"GCC payload"}), "the resolution states why");
          } },

        { "vcpkg: the Linux libc++ row hands over mcpp's clang through linux.cmake",
          with_vcpkg(t::row::linux_libcxx()),
          [] { return vcpkg_use(); },
          [](const t::result& r, t::checker& c) {
              const auto name = stem(derived_triplet(r));
              c.expect(name.starts_with("x64-linux-mcpp-"), "the derived triplet is x64-linux-mcpp-<hash>");
              c.expect(r.file("out/deps-vcpkg/triplets/mcpp-chain-linux.cmake")
                           .find("/scripts/toolchains/linux.cmake\")") != std::string::npos,
                       "the toolchain includes vcpkg's linux.cmake");
              const auto a = r.line("mcpp:action=", {"deps-vcpkg:install:" + name});
              c.expect(a.find("MCPP_VCPKG_CXX=") != std::string::npos && a.find("llvm/bin/clang++") != std::string::npos,
                       "clang++ is handed to vcpkg");
              c.expect(a.find("--host-triplet") == std::string::npos, "host tools keep vcpkg's host triplet");
              c.expect(a.find("\"PATH=") == std::string::npos, "PATH is left alone off the MSVC ABI");
              first_linux_name = name;
          } },

        { "vcpkg: the derived triplet's name does not depend on where the tools are",
          with_vcpkg(t::row::linux_libcxx()),
          [] { return vcpkg_use(); },
          [](const t::result& r, t::checker& c) {
              c.expect(!first_linux_name.empty() && stem(derived_triplet(r)) == first_linux_name,
                       "the same toolset under another root derives the same triplet");
          } },

        // ── deps-cmake ──────────────────────────────────────────────────────
        { "cmake: immutable generator selections have distinct cache identities",
          t::row::linux_gcc(),
          [] {
              using mcpp::deps::cmake::generator_key;
              const auto key = [](std::initializer_list<std::string> args) {
                  return generator_key(std::span<const std::string>(args.begin(), args.size()));
              };
              std::printf("generator-diff=%d\n", key({"-G", "Ninja"}) != key({"-G", "Unix Makefiles"}));
              std::printf("joined-same=%d\n", key({"-GNinja", "-Ax64"}) == key({"-G", "Ninja", "-A", "x64"}));
              std::printf("typed-same=%d\n", key({"-DCMAKE_GENERATOR:STRING=Ninja"}) == key({"-D", "CMAKE_GENERATOR=Ninja"}));
              std::printf("instance-diff=%d\n", key({"-DCMAKE_GENERATOR_INSTANCE=one"}) != key({"-DCMAKE_GENERATOR_INSTANCE=two"}));
              std::printf("ordinary-same=%d\n", key({"-DBUILD_TESTING=ON"}) == key({"-DBUILD_TESTING=OFF"}));
              return 0;
          },
          [](const t::result& r, t::checker& c) {
              for (const auto* name : {"generator-diff=", "joined-same=", "typed-same=", "instance-diff=", "ordinary-same="})
                  c.expect(r.has_line(name, {"1"}), name);
          } },

        { "cmake: another target uses a contract toolchain without flattening argv",
          with_subproject(t::row::linux_gcc().set("MCPP_TARGET", "aarch64-linux-gnu")
                                             .set("MCPP_TARGET_ARCH", "aarch64")),
          [] { return cmake_use(); },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              const auto script = r.file("out/deps-cmake/greet/greet.cmake");
              const auto toolchain = r.file("out/deps-cmake/greet/greet-contract.cmake");
              c.expect(script.find("-DCMAKE_TOOLCHAIN_FILE=") != std::string::npos,
                       "CMake and its probes load the same contract toolchain");
              c.expect(script.find("-DCMAKE_C_FLAGS=") == std::string::npos,
                       "contract arguments are not flattened into a native flags string");
              c.expect(toolchain.find("add_compile_options") != std::string::npos
                       && toolchain.find("add_link_options") != std::string::npos,
                       "native CMake options carry response-file references");
              c.expect(r.line("mcpp:action=", {"deps-cmake:greet"}).find("greet-contract.cmake")
                           != std::string::npos,
                       "the generated toolchain is an action input");
          } },

        { "cmake: a Visual Studio toolset is named, with Ninja, by default",
          with_subproject(t::row::windows_visual_studio("14.43.34808", "14.44.35207")),
          [] { return cmake_use(); },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              std::string script;
              for (auto const& f : r.files_under("out/deps-cmake/greet"))
                  if (f.ends_with("greet.cmake")) script = r.file(f);
              c.expect(script.find("[==[Ninja]==]") != std::string::npos, "the Ninja generator is used");
              c.expect(script.find("-DCMAKE_CXX_COMPILER=") != std::string::npos
                       && script.find("cl.exe") != std::string::npos, "cl.exe is named");
              c.expect(script.find("CMAKE_GENERATOR_INSTANCE") == std::string::npos,
                       "no Visual Studio generator is pointed at the instance");
              c.expect(r.line("mcpp:action=", {"deps-cmake:greet"}).find("\"INCLUDE=") != std::string::npos,
                       "the tools run with the engine's environment");
          } },

        { "cmake: generator visual_studio keeps the Visual Studio generator on that instance",
          with_subproject(t::row::windows_visual_studio("14.43.34808", "14.44.35207")),
          [] {
              mcpp::deps::cmake::options o;
              o.generator = mcpp::deps::cmake::options::generator_kind::visual_studio;
              return cmake_use(o);
          },
          [](const t::result& r, t::checker& c) {
              const auto script = r.file("out/deps-cmake/greet/greet.cmake");
              c.expect(script.find("[==[-DCMAKE_GENERATOR_INSTANCE=") != std::string::npos,
                       "CMAKE_GENERATOR_INSTANCE names the instance");
              c.expect(script.find("[==[version=14.43.34808]==]") != std::string::npos,
                       "-T version= names a toolset other than the instance's default");
              c.expect(script.find("[==[Ninja]==]") == std::string::npos, "the generator stays CMake's default");
              c.expect(script.find("MultiThreaded$<$<CONFIG:Debug>:Debug>DLL") != std::string::npos,
                       "the C runtime follows the program's (dynamic)");
              c.expect(script.find("-DCMAKE_GENERATOR_INSTANCE=<instance>") != std::string::npos,
                       "the key states the instance by the toolset it provides");
          } },

        { "cmake: a managed toolset is named, with Ninja and mcpp's ninja",
          with_subproject(t::row::windows_managed()
                              .set("MCPP_CXX_RUNTIME", "self-contained").set("MCPP_MSVC_CRT_LINKAGE", "static")),
          [] { return cmake_use(); },
          [](const t::result& r, t::checker& c) {
              std::string script;
              for (auto const& f : r.files_under("out/deps-cmake/greet"))
                  if (f.ends_with("greet.cmake")) script = r.file(f);
              c.expect(script.find("[==[Ninja]==]") != std::string::npos, "the Ninja generator is used");
              c.expect(script.find("-DCMAKE_MAKE_PROGRAM=") != std::string::npos
                       && script.find("ninja/ninja.exe") != std::string::npos, "mcpp's ninja runs it");
              c.expect(script.find("-DCMAKE_CXX_COMPILER=") != std::string::npos
                       && script.find("cl.exe") != std::string::npos, "cl.exe is named");
              c.expect(script.find("MultiThreaded$<$<CONFIG:Debug>:Debug>]==]") != std::string::npos,
                       "the C runtime follows the program's (static)");
              const auto a = r.line("mcpp:action=", {"deps-cmake:greet"});
              c.expect(a.find("\"INCLUDE=") != std::string::npos && a.find("\"PATH=") != std::string::npos,
                       "the tools run with the engine's environment");
              c.expect(script.find("/greet/build-") != std::string::npos,
                       "the build directory is keyed by the toolset");
          } },

        { "cmake: compilers in cache_args are the project's decision",
          with_subproject(t::row::linux_gcc()),
          [] {
              mcpp::deps::cmake::options o;
              o.cache_args = {"-DCMAKE_CXX_COMPILER=/opt/other/g++"};
              return cmake_use(o);
          },
          [](const t::result& r, t::checker& c) {
              const auto script = r.file("out/deps-cmake/greet/greet.cmake");
              c.expect(script.find("[==[Ninja]==]") == std::string::npos, "no generator is imposed");
              c.expect(script.find("gcc/bin/g++") == std::string::npos, "the row's compiler is not named");
          } },

        { "cmake: the compiler and the generator are chosen by the argument's name",
          t::row::linux_gcc(),
          [] {
              namespace c = mcpp::deps::cmake;
              auto say = [](const char* what, bool v) { std::printf("%s=%d\n", what, v ? 1 : 0); };
              using args = std::vector<std::string>;
              say("launcher", c::chooses_compiler(args{"-DCMAKE_CXX_COMPILER_LAUNCHER=sccache"}));
              say("target", c::chooses_compiler(args{"-DCMAKE_C_COMPILER_TARGET=x86_64-linux-gnu"}));
              say("compiler", c::chooses_compiler(args{"-DCMAKE_CXX_COMPILER=/opt/cxx"}));
              say("typed", c::chooses_compiler(args{"-DCMAKE_CXX_COMPILER:FILEPATH=/opt/cxx"}));
              say("spaced", c::chooses_compiler(args{"-D", "CMAKE_C_COMPILER=/opt/cc"}));
              say("toolchain_file", c::chooses_compiler(args{"-DCMAKE_TOOLCHAIN_FILE=t.cmake"}));
              say("toolchain", c::chooses_compiler(args{"--toolchain", "t.cmake"}));
              say("toolchain_eq", c::chooses_compiler(args{"--toolchain=t.cmake"}));
              say("platform", c::chooses_generator(args{"-DCMAKE_GENERATOR_PLATFORM=x64"}));
              say("gen_toolset", c::chooses_generator(args{"-DCMAKE_GENERATOR_TOOLSET=v143"}));
              say("dash_g", c::chooses_generator(args{"-G", "Ninja"}));
              say("generator", c::chooses_generator(args{"-DCMAKE_GENERATOR=Ninja"}));
              return 0;
          },
          [](const t::result& r, t::checker& c) {
              for (auto const* no : {"launcher=0", "target=0", "platform=0", "gen_toolset=0"})
                  c.expect(r.has_line(no), std::string(no) + ": the argument refines, it does not choose");
              for (auto const* yes : {"compiler=1", "typed=1", "spaced=1", "toolchain_file=1", "toolchain=1",
                                      "toolchain_eq=1", "dash_g=1", "generator=1"})
                  c.expect(r.has_line(yes), std::string(yes) + ": the argument chooses");
          } },

        { "cmake: build_shared_libs reaches CMake as BUILD_SHARED_LIBS, and the key states it",
          with_subproject(t::row::windows_managed()),
          [] {
              mcpp::deps::cmake::options o;
              o.build_shared_libs = true;
              return cmake_use(o);
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              std::string script;
              for (auto const& f : r.files_under("out/deps-cmake/greet"))
                  if (f.ends_with("greet.cmake")) script = r.file(f);
              c.expect(script.find("[==[-DBUILD_SHARED_LIBS=ON]==]") != std::string::npos,
                       "the configure step asks for shared libraries");
              const auto from = script.find("set(recipe [==[");
              const auto recipe = from == std::string::npos ? std::string()
                                                            : script.substr(from, script.find("]==])", from) - from);
              c.expect(recipe.find("arg -DBUILD_SHARED_LIBS=ON\n") != std::string::npos,
                       "an installation built shared has its own key");
          } },

        { "cmake: build_shared_libs false asks for static libraries",
          with_subproject(t::row::linux_gcc()),
          [] {
              mcpp::deps::cmake::options o;
              o.build_shared_libs = false;
              return cmake_use(o);
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              c.expect(r.file("out/deps-cmake/greet/greet.cmake").find("[==[-DBUILD_SHARED_LIBS=OFF]==]")
                           != std::string::npos,
                       "the configure step asks for static libraries");
          } },

        { "cmake: build_shared_libs unset leaves BUILD_SHARED_LIBS to the subproject",
          with_subproject(t::row::linux_gcc()),
          [] {
              mcpp::deps::cmake::options o;
              o.shared = true;
              return cmake_use(o);
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              c.expect(r.file("out/deps-cmake/greet/greet.cmake").find("BUILD_SHARED_LIBS") == std::string::npos,
                       "options::shared alone passes nothing to CMake");
          } },

        { "cmake: build_shared_libs and BUILD_SHARED_LIBS in cache_args together are refused",
          with_subproject(t::row::linux_gcc()),
          [] {
              mcpp::deps::cmake::options o;
              o.build_shared_libs = true;
              o.cache_args = {"-D", "BUILD_SHARED_LIBS:BOOL=OFF"};
              return cmake_use(o);
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code != 0, "the member fails");
              c.expect(r.errors.find("options::build_shared_libs and a BUILD_SHARED_LIBS") != std::string::npos,
                       "the reason names both statements");
              c.expect(!r.has_line("mcpp:action=", {"deps-cmake:greet"}), "no installation is declared");
          } },

        { "cmake: a launcher in cache_args keeps the named toolset and Ninja",
          with_subproject(t::row::windows_managed()),
          [] {
              mcpp::deps::cmake::options o;
              o.cache_args = {"-DCMAKE_CXX_COMPILER_LAUNCHER=sccache"};
              return cmake_use(o);
          },
          [](const t::result& r, t::checker& c) {
              std::string script;
              for (auto const& f : r.files_under("out/deps-cmake/greet"))
                  if (f.ends_with("greet.cmake")) script = r.file(f);
              c.expect(script.find("[==[Ninja]==]") != std::string::npos, "the Ninja generator is used");
              c.expect(script.find("cl.exe") != std::string::npos, "cl.exe is named");
              c.expect(script.find("[==[-DCMAKE_CXX_COMPILER_LAUNCHER=sccache]==]") != std::string::npos,
                       "the launcher reaches CMake");
          } },

        { "cmake: a named toolset's installation is keyed without a path of the machine",
          with_subproject(t::row::windows_managed()),
          [] { return cmake_use(); },
          [](const t::result& r, t::checker& c) {
              std::string script;
              for (auto const& f : r.files_under("out/deps-cmake/greet"))
                  if (f.ends_with("greet.cmake")) script = r.file(f);
              c.expect(script.find("AN INSTALLATION IS BUILT ONCE") != std::string::npos, "the script consults the cache");
              const auto from = script.find("set(recipe [==[");
              const auto to   = script.find("]==])", from);
              const auto recipe = from == std::string::npos ? std::string() : script.substr(from, to - from);
              c.expect(recipe.find("toolset msvc 14.44.35207; sdk 10.0.26100.0 (chain)") != std::string::npos,
                       "the key states the toolset's identity");
              c.expect(recipe.find("-DCMAKE_CXX_COMPILER=<cl.exe>") != std::string::npos,
                       "the key names the compiler by its file name");
              c.expect(recipe.find("arg <source>") != std::string::npos && recipe.find("-DCMAKE_INSTALL_PREFIX=<prefix>") != std::string::npos,
                       "the subproject's directories are placeholders");
              c.expect(recipe.find(r.root.generic_string()) == std::string::npos, "the key holds no path");
              c.expect(script.find("set(listed [==[\nCMakeLists.txt\n") != std::string::npos,
                       "the subproject's files are listed relative to it");
          } },

        { "cmake: a toolset CMake finds itself is not keyed",
          with_subproject(t::row::linux_gcc()),
          [] { return cmake_use(); },
          [](const t::result& r, t::checker& c) {
              c.expect(r.file("out/deps-cmake/greet/greet.cmake").find("AN INSTALLATION IS BUILT ONCE")
                       == std::string::npos, "the GCC row, where CMake finds its own compiler, is not keyed");
          } },

        { "cmake: cache off writes the uncached script",
          with_subproject(t::row::windows_managed()),
          [] {
              mcpp::deps::cmake::options o;
              o.cache = "off";
              return cmake_use(o);
          },
          [](const t::result& r, t::checker& c) {
              std::string script;
              for (auto const& f : r.files_under("out/deps-cmake/greet"))
                  if (f.ends_with("greet.cmake")) script = r.file(f);
              c.expect(!script.empty() && script.find("AN INSTALLATION IS BUILT ONCE") == std::string::npos,
                       "the script does not consult the cache");
          } },

        { "cmake: another build system's output directory in a subproject is not part of the key",
          with_foreign_output(with_subproject(t::row::windows_managed()), "pkg/greet", ".c"),
          [] { return cmake_use(); },
          [](const t::result& r, t::checker& c) {
              std::string script;
              for (auto const& f : r.files_under("out/deps-cmake/greet"))
                  if (f.ends_with("greet.cmake")) script = r.file(f);
              const auto from = script.find("set(listed [==[");
              const auto listed = from == std::string::npos ? std::string()
                                                            : script.substr(from, script.find("]==])", from) - from);
              c.expect(listed.find("\nx64/simd.c\n") != std::string::npos, "a directory named x64 is listed");
              c.expect(listed.find("\nnotag/kept.c\n") != std::string::npos,
                       "a CACHEDIR.TAG without the signature marks nothing");
              c.expect(listed.find("x64/Release") == std::string::npos, "an MSBuild intermediate directory is not");
              c.expect(listed.find("cmake-build-debug") == std::string::npos, "a CMake build directory is not");
              c.expect(listed.find("cache/") == std::string::npos, "a tagged cache directory is not");
          } },

        // ── rules-qt ────────────────────────────────────────────────────────
        { "qt: moc and lupdate read the package's files, not another build system's output",
          with_foreign_output(with_qt(t::row::linux_gcc()), "pkg", ".h"),
          [] {
              mcpp::rules::qt::options o;
              o.root = "../qt";
              o.modules = {"Core"};
              o.i18n.ts = {"app.ts"};
              o.i18n.update_sources = true;
              return mcpp::rules::qt::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              const auto u = r.line("mcpp:action=", {"qt:lupdate:app"});
              c.expect(u.find("pkg/widget.h") != std::string::npos && u.find("pkg/x64/simd.h") != std::string::npos
                       && u.find("pkg/notag/kept.h") != std::string::npos,
                       "lupdate reads the package's sources, a directory named x64 among them");
              c.expect(u.find("x64/Release") == std::string::npos && u.find("cmake-build-debug") == std::string::npos
                       && u.find("pkg/cache/") == std::string::npos,
                       "lupdate reads nothing another build system wrote");
              c.expect(r.has_line("mcpp:action=", {"qt:moc:", "widget"}) && r.has_line("mcpp:action=", {"qt:moc:", "simd"}),
                       "moc reads the package's headers");
              c.expect(!r.has_line("mcpp:action=", {"qt:moc:", "ui_form"}) && !r.has_line("mcpp:action=", {"qt:moc:", "stale"}),
                       "moc reads no header another build system wrote");
          } },

        // ── the tool resolver (0.19.0, mcpp#755) ────────────────────────────
        //
        // One order for every member: the build program's choice, the member's
        // legacy variable, the engine's override, the declared payload. Each
        // case states what the engine would answer and reads which source the
        // resolver took -- and, for a choice, that no payload was requested.
        { "tool: a choice names the program and asks for no payload",
          // Relative to the package root, which is where a build program's own
          // option would name it.
          t::row::linux_libcxx().file("pkg/opt/bin/cmake")
              .xpkg("xim", "cmake", "{root}/payload")
              .xpkg_source("xim", "cmake", "pending"),
          [] {
              const auto f = tool_resolve(mcpp::plugins::tool::program(
                  std::string(mcpp::manifest_dir()) + "/opt/bin/cmake"));
              std::printf("source=%s program=%s\n",
                          std::string(mcpp::plugins::tool::name(f.source)).c_str(),
                          f.program.c_str());
              return f ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.has_line("source=choice", "opt/bin/cmake"), "the choice is the source");
              c.expect(!r.has_line("mcpp:xpkg-request="), "a choice requests no payload");
              c.expect(r.has_line("mcpp:decision=tool:mcpp.deps.cmake:cmake", {"choice", "opt/bin/cmake"}),
                       "the decision names the choice and the program");
          } },

        { "tool: a stated path resolves whichever executable suffix the file carries",
          // What a shell hands a build program on Windows: `command -v cmake`
          // answers a path with no `.exe`, for a `cmake.exe`. Process creation
          // there appends the suffix, so the resolver does too -- stated on a
          // Linux row, because the rule is the same on every host.
          t::row::linux_libcxx().file("pkg/opt/bin/cmake.exe")
              .xpkg_source("xim", "cmake", "pending"),
          [] {
              const auto f = tool_resolve(mcpp::plugins::tool::program(
                  std::string(mcpp::manifest_dir()) + "/opt/bin/cmake"));
              std::printf("source=%s program=%s\n",
                          std::string(mcpp::plugins::tool::name(f.source)).c_str(),
                          f.program.c_str());
              return f ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.has_line("source=choice", "opt/bin/cmake.exe"),
                       "the file beside the stated path answers");
              c.expect(!r.has_line("mcpp:xpkg-request="), "a choice requests no payload");
          } },

        { "tool: an override answers, and the payload is not consulted",
          t::row::linux_libcxx().file("opt/bin/cmake")
              .xpkg("xim", "cmake", "{root}/opt")
              .xpkg_source("xim", "cmake", "override")
              .xpkg_program("xim", "cmake", "{root}/opt/bin/cmake"),
          [] {
              const auto f = tool_resolve();
              std::printf("source=%s program=%s\n",
                          std::string(mcpp::plugins::tool::name(f.source)).c_str(),
                          f.program.c_str());
              return f ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.has_line("source=override", "opt/bin/cmake"), "the override is the source");
              c.expect(!r.has_line("mcpp:xpkg-request="), "an override requests nothing");
          } },

        { "tool: a payload declared on request is asked for, and nothing is planned",
          t::row::linux_libcxx().xpkg_source("xim", "cmake", "pending"),
          [] {
              const auto f = tool_resolve();
              std::printf("pending=%d program=%s\n", f.pending() ? 1 : 0, f.program.c_str());
              return 0;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.has_line("pending=1 program="), "the resolver reports it is pending");
              c.expect(r.has_line("mcpp:xpkg-request=xim:cmake"), "the payload is requested");
              c.expect(!r.has_line("mcpp:decision="), "a pending payload decides nothing yet");
          } },

        { "tool: the installed payload answers when nothing else does",
          t::row::linux_libcxx().file("payload/bin/cmake")
              .xpkg("xim", "cmake", "{root}/payload"),
          [] {
              const auto f = tool_resolve();
              std::printf("source=%s program=%s\n",
                          std::string(mcpp::plugins::tool::name(f.source)).c_str(),
                          f.program.c_str());
              return f ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.has_line("source=payload", "payload/bin/cmake"), "the payload is the source");
              c.expect(r.has_line("mcpp:decision=tool:mcpp.deps.cmake:cmake", {"payload"}),
                       "the decision names the payload");
          } },

        { "tool: nothing names it, and the refusal lists every way to",
          t::row::linux_libcxx(),
          [] {
              const auto f = tool_resolve();
              std::printf("%s\n", mcpp::plugins::tool::describe_missing(
                  mcpp::deps::cmake_spec("mcpp.deps.cmake"), f).c_str());
              return 0;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.has_line("mcpp.deps.cmake: no cmake."), "it names the member and the tool");
              c.expect(r.has_line("  consulted: options::cmake (not set)"), "it names the option");
              c.expect(r.has_line("    o.cmake = "), "it names the build program's way");
              c.expect(r.has_line("    [xlings.overrides] \"xim:cmake\" = \"/path\""),
                       "it names the manifest's way");
              c.expect(r.has_line("    MCPP_XLINGS_OVERRIDE_XIM_CMAKE=/path"),
                       "it names the environment's way");
          } },

        { "qt: rcc tracks the resource paths stored in XML text children",
          with_qt(t::row::linux_gcc())
              .file("qt/bin/rcc").file("qt/bin/rcc.exe")
              .file("pkg/res/app.qrc",
                    "<RCC><qresource prefix=\"/\">\n"
                    "  <file>assets/greeting.txt</file>\n"
                    "  <file alias=\"sample.zip\"> \n"
                    "    data/Sample<!-- split text -->Project.zip \n"
                    "  </file>\n"
                    "</qresource></RCC>\n")
              .file("pkg/res/assets/greeting.txt", "hello\n")
              .file("pkg/res/data/SampleProject.zip", "resource contents\n"),
          [] {
              mcpp::rules::qt::options o;
              o.root = "../qt";
              o.modules = {"Core"};
              o.resources = {"res/app.qrc"};
              return mcpp::rules::qt::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              const auto a = r.line("mcpp:action=", {"qt:rcc:app"});
              c.expect(a.find("pkg/res/assets/greeting.txt") != std::string::npos,
                       "rcc tracks a resource relative to the qrc directory");
              c.expect(a.find("pkg/res/data/SampleProject.zip") != std::string::npos,
                       "rcc tracks the aliased source after joining and trimming text children");
          } },

        // ── the package reader (mcpp::plugins::package) ─────────────────────
        { "package: a staged package's metadata is read, every field",
          with_stage(t::row::linux_libcxx()),
          [] {
              auto p = mcpp::plugins::package::read(mcpp::pack_stage_dir());
              if (!p) { std::printf("error=%s\n", p.error().c_str()); return 1; }
              std::printf("name=%s version=%s platform=%s legs=%zu runner=%s\n", p->name.c_str(),
                          p->version.c_str(), p->platform.c_str(), p->legs.size(), p->runner.front().c_str());
              std::printf("images=%zu entry.x86_64=%s first=%s\n",
                          mcpp::plugins::package::files_with_role(*p, "image").size(),
                          mcpp::plugins::package::entry_of(*p, "x86_64").c_str(), p->entry.front().first.c_str());
              std::printf("leg.launcher=[%s]\n", p->files.front().leg.c_str());
              return 0;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the document is read");
              c.expect(r.has_line("name=hello version=0.1.0 platform=openkal-platform@0.17.2 legs=2 runner=okrun"),
                       "the package, its platform, its legs and its runner");
              c.expect(r.has_line("images=2 entry.x86_64=lib/x86_64/hello.oke first=aarch64"),
                       "the images by role, the entry by architecture, in the document's order");
              c.expect(r.has_line("leg.launcher=[]"), "a file every leg shares has no leg");
          } },

        { "package: a document of another schema is refused, naming it",
          with_stage(t::row::linux_libcxx(), R"({"schema": 2, "name": "x", "files": []})"),
          [] {
              auto p = mcpp::plugins::package::read(mcpp::pack_stage_dir());
              if (p) return 0;
              std::printf("error=%s\n", p.error().c_str());
              return 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code != 0, "the document is refused");
              c.expect(r.has_line("error=", {"schema 2", "reads schema 1"}), "the refusal names both schemas");
          } },

        // ── a package format's provider (mcpp.plugins.platform) ─────────────
        { "provide_format: an ordinary pass declares the format and submits nothing",
          with_stage(t::row::linux_libcxx()),
          [] { return provide_okb(); },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the provider succeeds");
              c.expect(r.has_line("mcpp:pack-format=okb"), "the format is declared on every pass");
              c.expect(r.count("mcpp:action=") == 0, "no action outside the pass that asks for the format");
          } },

        { "provide_format: the pass for the format makes the action from the staged package",
          with_stage(t::row::linux_libcxx()).pack("okb", "{root}/stage/hello-0.1.0-openkal"),
          [] { return provide_okb(); },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the provider succeeds");
              c.expect(r.has_line("mcpp:pack-format=okb"), "the format is declared");
              c.expect(r.has_line("mcpp:action=", {"\"role\":\"artifact\"", "hello-0.1.0.okb", "${mcpp.stage_dir}"}),
                       "one artifact action, named from the package's metadata");
          } },

        { "provide_format: the pass for the format without a staged package is refused",
          t::row::linux_libcxx().pack("okb", "{root}/nowhere"),
          [] { return provide_okb(); },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code != 0, "the provider fails");
              c.expect(r.count("mcpp:action=") == 0, "no action");
              c.expect(r.has_line("mcpp:warning=", {"provide_format", "mcpp-package.json"}),
                       "the refusal names the missing document");
          } },

        { "provide_format: a format mcpp writes itself is refused",
          t::row::linux_libcxx(),
          [] { return pf::provide_format("zip", [](auto const&, mcpp::action&) { return true; }) ? 0 : 1; },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code != 0, "the provider fails");
              c.expect(!r.has_line("mcpp:pack-format="), "nothing is declared");
              c.expect(r.has_line("mcpp:warning=", {"'zip' is a format mcpp writes itself"}), "the refusal names it");
          } },

        // ── the platform's fields (mcpp.plugins.platform) ───────────────────
        { "platform: the link, the names, the seal and the runner's host are stated as directives",
          t::row::linux_libcxx().phase("platform"),
          [] {
              bool ok = pf::link::driver("lld") && pf::link::start("ok_main")
                     && pf::link::input_from("ok-notes.S", {"okld", "note-source"})
                     && pf::link::input_file("link/startup.S")
                     && pf::artifact_names("{name}.oke", "lib{name}.okso")
                     && pf::seal({ { "okld", "note", "{}" }, { "okld", "check", "{}", "--with", "{needed}" } })
                     && pf::run_host("same-arch");
              return ok ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "every builder states its field");
              c.expect(r.has_line("mcpp:link-driver=lld"), "the driver");
              c.expect(r.has_line("mcpp:link-start=ok_main"), "the entry");
              c.expect(r.has_line("mcpp:link-input=from:ok-notes.S:okld")
                       && r.has_line("mcpp:link-input=from:ok-notes.S:note-source"), "a program's output, word by word");
              c.expect(r.has_line("mcpp:link-input=file:", {"/pkg/link/startup.S"}),
                       "a relative input is the package's own, made absolute");
              c.expect(r.has_line("mcpp:artifact-name=exe:{name}.oke")
                       && r.has_line("mcpp:artifact-name=shared:lib{name}.okso"), "both names");
              c.expect(r.has_line("mcpp:seal=0:okld") && r.has_line("mcpp:seal=1:{needed}")
                       && r.count("mcpp:seal=") == 8, "two steps, every word in order");
              c.expect(r.has_line("mcpp:run-host=same-arch"), "the runner's host");
          } },

        { "platform: a malformed field is refused at the builder, and nothing is stated",
          t::row::linux_libcxx().phase("platform"),
          [] {
              int refused = 0;
              refused += !pf::link::driver("gold");
              refused += !pf::link::start("9lives");
              refused += !pf::link::input_from("a:b", {"okld"});
              refused += !pf::link::input_from("notes.S", std::span<const std::string>{});
              refused += !pf::artifact_names("app-{name}");
              refused += !pf::artifact_names("{name}", "lib{name}{name}.so");
              refused += !pf::seal(std::span<const std::vector<std::string>>{});
              refused += !pf::run_host("sometimes");
              std::printf("refused=%d\n", refused);
              return refused == 8 ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.has_line("refused=8"), "every malformed value is refused");
              c.expect(!r.has_line("mcpp:link-driver=") && !r.has_line("mcpp:link-start=")
                       && !r.has_line("mcpp:link-input=") && !r.has_line("mcpp:artifact-name=")
                       && !r.has_line("mcpp:seal=") && !r.has_line("mcpp:run-host="),
                       "no directive is stated for a refused value");
              c.expect(r.has_line("mcpp:warning=", {"link::driver", "\"lld\" and \"compiler\""}),
                       "a refusal names the call and the values it takes");
              c.expect(r.has_line("mcpp:warning=", {"artifact_names", "at its start"}),
                       "an executable's pattern begins with {name}");
          } },



        { "qt: a project that names no 0.27 option gets the directives of 0.26",
          with_full_qt(t::row::linux_gcc()),
          [] {
              mcpp::rules::qt::options o;
              o.root = "../qt";
              o.modules = {"Core"};
              o.deploy_plugins = {"platforms"};
              o.forms = {"form.ui"};
              o.resources = {"res/app.qrc"};
              o.i18n.ts = {"app.ts"};
              o.i18n.update_sources = true;
              return mcpp::rules::qt::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              // The text is the directives of 0.26.1 for these options, recorded before
              // any 0.27 change: a later change that alters one fails here.
              std::ifstream in(std::filesystem::path(mcpp::manifest_dir()) / "golden" / "qt-0.26.txt");
              const std::string golden{std::istreambuf_iterator<char>(in), {}};
              c.expect(!golden.empty() && directives(r) == golden, "every directive is what 0.26 stated; got:\n" + directives(r));
          } },


        { "qt: moc_json and moc_includes add the type description and the SDK's include directories to moc",
          with_full_qt(t::row::linux_gcc()).file("qt/lib/libQt6Qml.so"),
          [] {
              mcpp::rules::qt::options o;
              o.root = "../qt";
              o.modules = {"Core", "Qml"};
              o.deploy_plugins = {};
              o.moc_json = true;
              o.moc_includes = true;
              const auto done = mcpp::rules::qt::compile_ex(o);
              std::printf("ok=%d linked=%zu mocs=%zu\n", done.ok, done.linked.size(), done.mocs.size());
              for (auto const& m : done.mocs)
                  std::printf("unit=%s|%s|%s\n", std::filesystem::path(m.header).filename().string().c_str(),
                              std::filesystem::path(m.cpp).filename().string().c_str(),
                              std::filesystem::path(m.json).filename().string().c_str());
              return done.ok ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              c.expect(r.has_line("ok=1 linked=2 mocs=1"), "compile_ex reports the modules it linked and the moc units");
              c.expect(r.has_line("unit=widget.h|moc_widget.cpp|moc_widget.cpp.json"), "a unit names its header, source and description");
              const auto a = r.line("mcpp:action=", {"qt:moc:moc_widget.cpp"});
              c.expect(a.find("\"--output-json\"") != std::string::npos, "moc writes the description");
              c.expect(a.find("moc_widget.cpp.json\"]") != std::string::npos, "the description is a declared output");
              c.expect(a.find("\"-I" + r.root.generic_string() + "/qt/include\"") != std::string::npos
                       && a.find("\"-I" + r.root.generic_string() + "/qt/include/QtCore\"") != std::string::npos
                       && a.find("\"-I" + r.root.generic_string() + "/qt/include/QtQml\"") != std::string::npos,
                       "moc is given the SDK's include directory and each linked module's");
          } },

        { "qt: lupdate reads the extensions the project names",
          with_full_qt(t::row::linux_gcc()).file("pkg/ui/Main.qml", "Text { text: qsTr(\"hi\") }\n").file("pkg/ui/util.js"),
          [] {
              mcpp::rules::qt::options o;
              o.root = "../qt";
              o.modules = {"Core"};
              o.deploy_plugins = {};
              o.i18n.ts = {"app.ts"};
              o.i18n.update_sources = true;
              o.i18n.extensions = {"cpp", "h", "qml", "js"};
              return mcpp::rules::qt::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              const auto u = r.line("mcpp:action=", {"qt:lupdate:app"});
              c.expect(u.find("\"-extensions\",\"cpp,h,qml,js\"") != std::string::npos, "the extensions reach lupdate");
              c.expect(u.find("pkg/ui/Main.qml") != std::string::npos && u.find("pkg/ui/util.js") != std::string::npos,
                       "the walk collects the files of those extensions");
              c.expect(r.has_line("mcpp:rerun-if-changed-glob=**/*.qml"), "a new file of one of them re-plans");
          } },


        // ── rules-qml ───────────────────────────────────────────────────────
        { "qml: a module's qmldir, qrc and resource paths",
          with_probe(with_qml_sdk(t::row::linux_gcc())),
          [] { make_odd_resource(); return mcpp::rules::qml::compile(probe_options()) ? 0 : 1; },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              const std::string dir = "out/qml/Probe/";
              c.expect(r.file(dir + "qmldir") ==
                       "module Probe\ntypeinfo Probe.qmltypes\nprefer :/qt/qml/Probe/\n"
                       "Main 1.2 Main.qml\nsingleton Style 1.2 Style.qml\nInner 1.2 sub/Inner.qml\n",
                       "the qmldir: module, typeinfo, prefer, then a line per type; a singleton marked, a lowercase file and a script not listed; got:\n" + r.file(dir + "qmldir"));
              const std::string qrc = r.file("out/qml/Probe/Probe.qrc");
              c.expect(mentions(qrc, "<qresource prefix=\"/qt/qml/Probe\">") && mentions(qrc, "<file alias=\"qmldir\">"),
                       "the resources sit under the prefix and the uri as a path, beside the qmldir");
              c.expect(mentions(qrc, "<file alias=\"sub/Inner.qml\">") && mentions(qrc, "<file alias=\"util.js\">"),
                       "a nested file keeps its relative path");
              c.expect(mentions(qrc, "alias=\"data/a&amp;b.txt\">") && mentions(qrc, "a&amp;b.txt</file>"),
                       "a name with & is escaped in the alias and the path");
              if (r.has_line("odd=1"))
                  c.expect(mentions(qrc, "alias=\"data/c&lt;d&gt;.txt\">") && mentions(qrc, "c&lt;d&gt;.txt</file>"),
                           "so are < and >, where a host can name such a file");
              c.expect(!mentions(qrc, "\\"), "no backslash");
              c.expect(r.has_line("mcpp:rerun-if-changed=", {"qml/Probe/Main.qml"}) && r.has_line("mcpp:rerun-if-changed=", {"qml/Probe/sub/Inner.qml"})
                       && r.has_line("mcpp:rerun-if-changed-glob=qml/Probe/**/*.qml"),
                       "every .qml file the plan read is declared, and the glob that found it");
          } },

        { "qml: the actions of a module with C++ types, in order of their dependencies",
          with_probe(with_qml_sdk(t::row::linux_gcc())),
          [] { return mcpp::rules::qml::compile(probe_options()) ? 0 : 1; },
          [](const t::result& r, t::checker& c) {
              const auto moc = action_of(r, "qt:moc:moc_thing.cpp");
              c.expect(mentions(moc, "\"--output-json\"") && mentions(moc, "moc_thing.cpp.json"), "moc writes the type description");
              const auto reg = action_of(r, "qml:registrar:Probe");
              c.expect(mentions(reg, "--generate-qmltypes=") && mentions(reg, "Probe.qmltypes") && mentions(reg, "\"--import-name=Probe\"")
                       && mentions(reg, "\"--major-version=1\"") && mentions(reg, "\"--minor-version=2\""),
                       "the registrar is told the uri and the version");
              c.expect(mentions(reg, "--foreign-types=") && mentions(reg, "/qt/metatypes/qt6core_metatypes.json"),
                       "the SDK's type descriptions are foreign types");
              c.expect(mentions(reg, "Probe_qmltyperegistrations.cpp") && mentions(reg, "moc_thing.cpp.json"), "its output and input");
              const auto rcc = action_of(r, "qml:rcc:Probe");
              c.expect(mentions(rcc, "qrc_Probe.cpp") && mentions(rcc, "qml/Probe/Main.qml") && mentions(rcc, "data/a&b.txt"),
                       "rcc reads every file of the module and writes qrc_<module>.cpp");
              const auto cg = action_of(r, "qml:cachegen:Probe:sub/Inner.qml");
              c.expect(mentions(cg, "\"--bare\"") && mentions(cg, "\"--resource-path\",\"/qt/qml/Probe/sub/Inner.qml\"")
                       && mentions(cg, "\"--resource\"") && mentions(cg, "Probe_sub_Inner_qml.cpp"),
                       "a file is compiled under its resource path, into a name made from it");
              c.expect(mentions(cg, "Probe.qmltypes") && mentions(cg, "out/qml/Probe/qmldir"),
                       "and reads the module's type description and qmldir, which orders it after the registrar");
              c.expect(r.has_line("mcpp:action=", {"qml:cachegen:Probe:util.js"}), "a script is compiled too");
              const auto loader = action_of(r, "qml:cachegen:Probe:loader");
              c.expect(mentions(loader, "Probe_qmlcache_loader.cpp\",\"@") || mentions(loader, "Probe_qmlcache_loader.cpp\""),
                       "the loader's output ends in qmlcache_loader.cpp, the name that makes qmlcachegen write one");
              const std::string rsp = r.file("out/qml/Probe/loader.rsp");
              c.expect(rsp.starts_with("--resource\n") && mentions(rsp, "\n/qt/qml/Probe/Main.qml\n") && mentions(rsp, "\n/qt/qml/Probe/sub/Inner.qml\n")
                       && !mentions(rsp, "data/"), "the loader is given the resource paths of the compiled files and no resource");
              c.expect(r.has_line("mcpp:include-dir=", {"pkg/src"}), "the registrations can include the header");
          } },

        { "qml: aot = false, no C++ types, shaders and lint change the set of actions",
          with_probe(with_qml_sdk(t::row::linux_gcc())).file("pkg/shaders/a.frag", "#version 440\n"),
          [] {
              auto o = probe_options();
              o.modules[0].aot = false;
              o.modules[0].shaders = {"shaders/a.frag"};
              o.lint = true;
              o.lint_warnings_are_errors = true;
              return mcpp::rules::qml::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              c.expect(!r.has_line("mcpp:action=", {"qml:cachegen:"}), "aot = false declares no cachegen action");
              c.expect(r.has_line("mcpp:action=", {"qml:rcc:Probe"}) && r.has_line("mcpp:action=", {"qml:registrar:Probe"}),
                       "the sources are still embedded and the types registered");
              const auto qsb = action_of(r, "qml:qsb:Probe:a.frag");
              c.expect(mentions(qsb, "\"--qt6\"") && mentions(qsb, "a.frag.qsb") && mentions(qsb, "LD_LIBRARY_PATH"),
                       "qsb is given its arguments, writes <file>.qsb and gets the SDK's library directory");
              c.expect(mentions(r.file("out/qml/Probe/Probe.qrc"), "alias=\"shaders/a.frag.qsb\""), "the shader is a resource of the module");
              c.expect(mentions(action_of(r, "qml:rcc:Probe"), "a.frag.qsb"), "rcc waits for the shader");
              const auto lint = action_of(r, "qml:lint:Probe:Main.qml");
              c.expect(mentions(lint, "\"role\":\"check\"") && mentions(lint, "\"--max-warnings\",\"0\""),
                       "lint is a check, one per file, that fails on a warning when asked");
              c.expect(!r.has_line("mcpp:action=", {"qml:lint:Probe:util.js"}), "a script is not linted");
          } },

        { "qml: shaders without qsb are a warning, and the resources do not name a file nobody builds",
          with_probe(with_qml_sdk(t::row::linux_gcc(), false)).file("pkg/shaders/a.frag", "#version 440\n"),
          [] {
              auto o = probe_options();
              o.modules[0].shaders = {"shaders/a.frag"};
              return mcpp::rules::qml::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              c.expect(r.has_line("mcpp:warning=", {"`qsb` not found", "xim:qt-addons"}), "the warning says which payload carries qsb");
              c.expect(!r.has_line("mcpp:action=", {"qml:qsb:"}), "no qsb action is declared");
              c.expect(!mentions(r.file("out/qml/Probe/Probe.qrc"), ".qsb") && !mentions(action_of(r, "qml:rcc:Probe"), ".qsb"),
                       "neither the qrc nor rcc's inputs name a shader that is not built");
          } },

        { "qml: a module with no C++ type runs no registrar and its qmldir names no typeinfo",
          with_qml_sdk(t::row::linux_gcc()).file("pkg/q/Chip.qml", "import QtQuick\nItem { }\n"),
          [] {
              mcpp::rules::qml::options o;
              o.qt.root = "../qt";
              o.qt.modules = {"Core"};
              o.qt.deploy_plugins = {};
              mcpp::rules::qml::qml_module m;
              m.uri = "Plain";
              m.sources = {"q/*.qml"};
              o.modules = {m};
              return mcpp::rules::qml::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              c.expect(!r.has_line("mcpp:action=", {"qml:registrar:"}), "no registrar");
              c.expect(r.file("out/qml/Plain/qmldir") == "module Plain\nprefer :/qt/qml/Plain/\nChip 1.0 Chip.qml\n",
                       "no typeinfo line; the root is the directory the sources share; got:\n" + r.file("out/qml/Plain/qmldir"));
              c.expect(r.has_line("mcpp:action=", {"qml:cachegen:Plain:Chip.qml"}), "the file is compiled");
          } },


        { "qml: what is stated wrongly is refused, naming it, before any action is declared",
          with_probe(with_qml_sdk(t::row::linux_gcc())).file("pkg/qml/Probe/Extra.qml", "Item {}\n"),
          [] {
              using namespace mcpp::rules::qml;
              int refused = 0;
              auto base = [] { return probe_options(); };
              { auto o = base(); o.modules[0].uri = "a..b";        refused += !compile(o); }
              { auto o = base(); o.modules[0].uri = "../x";        refused += !compile(o); }
              { auto o = base(); o.modules[0].uri = "9lives";      refused += !compile(o); }
              { auto o = base(); o.modules[0].version = "1";       refused += !compile(o); }
              { auto o = base(); o.modules[0].version = "1.x";     refused += !compile(o); }
              { auto o = base(); o.modules[0].prefix = "qt/qml";   refused += !compile(o); }
              { auto o = base(); o.modules.push_back(o.modules[0]); refused += !compile(o); }
              { auto o = base(); o.modules[0].uri = "QtQuick";     refused += !compile(o); }
              { auto o = base(); o.modules.push_back(o.modules[0]); o.modules[1].uri = "Probe_2";
                o.modules[0].uri = "a.b"; o.modules[1].uri = "a_b"; refused += !compile(o); }
              std::printf("refused=%d\n", refused);
              return 0;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.has_line("refused=9"), "all nine are refused");
              c.expect(mentions(r.errors, "`a..b` is not a module uri") && mentions(r.errors, "`../x` is not a module uri")
                       && mentions(r.errors, "`9lives` is not a module uri"), "an invalid uri is named");
              c.expect(mentions(r.errors, "the version `1` of Probe") && mentions(r.errors, "the version `1.x` of Probe"), "an invalid version is named");
              c.expect(mentions(r.errors, "the prefix `qt/qml`"), "an invalid prefix is named");
              c.expect(mentions(r.errors, "is stated twice"), "a module stated twice, or two that name one file, is refused");
              c.expect(mentions(r.errors, "module of the Qt SDK"), "a uri the SDK already has is refused");
          } },

        { "qml: headers belong to one module each, and a header nobody lists is not guessed when there are several",
          with_qml_sdk(t::row::linux_gcc())
              .file("pkg/a/A.qml", "Item {}\n").file("pkg/b/B.qml", "Item {}\n")
              .file("pkg/src/one.h", "class One { Q_OBJECT QML_ELEMENT };\n")
              .file("pkg/src/two.h", "class Two { Q_OBJECT QML_ELEMENT };\n")
              .file("pkg/src/plain.h", "class Plain { Q_OBJECT };\n"),
          [] {
              using namespace mcpp::rules::qml;
              auto make = [] {
                  options o;
                  o.qt.root = "../qt";
                  o.qt.modules = {"Core"};
                  o.qt.deploy_plugins = {};
                  qml_module a, b;
                  a.uri = "m.a"; a.sources = {"a/*.qml"};
                  b.uri = "m.b"; b.sources = {"b/*.qml"};
                  o.modules = {a, b};
                  return o;
              };
              int refused = 0;
              { auto o = make(); refused += !compile(o); }                                   // two QML headers, none assigned
              { auto o = make(); o.modules[0].headers = {"src/one.h"}; refused += !compile(o); }   // `two.h` still belongs to nobody
              { auto o = make(); o.modules[0].headers = {"src/one.h", "src/two.h"}; o.modules[1].headers = {"src/two.h"}; refused += !compile(o); }
              std::printf("refused=%d\n", refused);
              auto o = make();
              o.modules[0].headers = {"src/one.h"};
              o.modules[1].headers = {"src/two.h"};
              return compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "with each header listed the member succeeds");
              c.expect(r.has_line("refused=3"), "an unassigned header, a header left over, a header listed twice are each refused");
              c.expect(mentions(r.errors, "registers QML types and belongs to no module") && mentions(r.errors, "is listed for both m.a and m.b"),
                       "the refusals name the header and the modules");
              const auto a = action_of(r, "qml:registrar:m.a");
              c.expect(mentions(a, "moc_one.cpp.json") && mentions(a, "moc_two.cpp.json") && a.find("--foreign-types=") != std::string::npos,
                       "m.a's registrar reads its own description and is given m.b's as foreign types");
              c.expect(r.count("mcpp:action={\"id\":\"qml:registrar:") == 2, "a header with no QML macro registers nothing");
              c.expect(mentions(a, "--foreign-types=") && mentions(a, "moc_plain.cpp.json"),
                       "it is known to the registrar all the same, as a base class a type may derive from");
          } },

        { "qml: a target that is not linux, windows or macos is one warning and no action",
          with_probe(with_qml_sdk(t::row::linux_gcc())).set("MCPP_TARGET_OS", "android"),
          [] { return mcpp::rules::qml::compile(probe_options()) ? 0 : 1; },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              c.expect(r.count("mcpp:action=") == 0 && r.count("mcpp:deploy=") == 0, "nothing is declared");
              c.expect(r.has_line("mcpp:warning=", {"QML is built for linux, windows and macos", "android"}), "the warning names the target");
          } },

        { "qml: a missing tool or Quick library is a warning, and the plan succeeds",
          t::row::linux_gcc().file("qt/lib/libQt6Core.so").file("qt/libexec/moc")
              .file("pkg/qml/Probe/Main.qml", "Item {}\n"),
          [] {
              auto o = probe_options();
              o.modules[0].sources = {"qml/Probe/*.qml"};
              o.modules[0].resources = {};
              return mcpp::rules::qml::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              c.expect(r.has_line("mcpp:warning=", {"`rcc` not found", "xim:qt", "QtQml library only"}), "the warning says which payload carries Quick");
              c.expect(r.count("mcpp:action=") == 0, "no QML action is declared for a module that cannot be built");
          } },

        { "qml: no SDK is the warning rules-qt gives, and the member succeeds",
          t::row::linux_gcc(),
          [] {
              mcpp::rules::qml::options o;
              mcpp::rules::qml::qml_module m;
              m.uri = "Probe";
              o.modules = {m};
              return mcpp::rules::qml::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0 && r.count("mcpp:action=") == 0, "nothing is declared, nothing fails");
              c.expect(r.has_line("mcpp:warning=", {"no Qt SDK"}), "the SDK's absence is said once");
          } },

        { "qml: Qt's own modules the program imports are placed under qml/, by the imports of the SDK's own files",
          with_probe(with_qml_sdk(t::row::linux_gcc())),
          [] { return mcpp::rules::qml::compile(probe_options()) ? 0 : 1; },
          [](const t::result& r, t::checker& c) {
              const auto d = deployed(r);
              auto has = [&](const std::string& f) { return d.contains(f); };
              c.expect(has("qml/QtQuick/Controls/qmldir") && has("qml/QtQuick/Controls/Button.qml"), "the module the project imports");
              c.expect(has("qml/QtQuick/qmldir") && has("qml/QtQuick/libqtquick2plugin.so"), "QtQuick, which a .qml file of Controls imports, with its plugin");
              c.expect(has("qml/QtQml/qmldir") && has("qml/QtQml/Models/qmldir"), "an `import` and a `depends` line of a qmldir are followed");
              c.expect(has("qml/QtQuick/Controls/Basic/qmldir"), "a `default import` is followed");
              c.expect(has("qml/QtQuick/Controls/Material/qmldir") && has("qml/QtQuick/Controls/Fusion/qmldir"),
                       "an `optional import` is followed: any style can be chosen at run time");
              c.expect(has("qml/QtQuick/Controls/Material/impl/qmldir") && has("qml/QtQuick/Controls/Material/impl/Ripple.qml"),
                       "a nested module is found through an import in a .qml file and placed on its own, with a `;` after the import");
              c.expect(has("qml/QtQuick/Templates/qmldir"), "an `import` line of a qmldir");
              c.expect(!has("qml/QtQuick/plugins.qmltypes") && !has("qml/QtQuick/designer/Hidden.qml"), "type descriptions and designer files are not run time");
              std::size_t files = 0, qmldirs = 0;
              for (auto const& f : d) {
                  if (!f.starts_with("qml/")) continue;
                  ++files;
                  if (f.ends_with("/qmldir")) ++qmldirs;
              }
              c.expect(files == 13, "exactly the 13 files of those modules, and no qt.conf or plugin among them; got " + std::to_string(files));
              c.expect(qmldirs == 9, "nine modules; got " + std::to_string(qmldirs));
              c.expect(!mentions(r.errors, "NotAModule") && !r.has_line("mcpp:warning=", {"NotAModule"}),
                       "an import in a comment is not an import");
          } },

        { "qml: styles limits the optional imports, imports and import_paths add modules, an unknown Qt module is a warning",
          with_probe(with_qml_sdk(t::row::linux_gcc()))
              .file("pkg/extra/Acme/Gadget/qmldir", "module Acme.Gadget\nimport QtQuick\n")
              .file("pkg/extra/Acme/Gadget/Gadget.qml", "Item {}\n")
              .file("pkg/qml/Probe/User.qml", "import Acme.Gadget\nimport Probe\nimport QtQuick.Nothing\nimport Dynamic.Thing\nItem {}\n"),
          [] {
              auto o = probe_options();
              o.styles = {"Basic"};
              o.imports = {"QtQml.Models"};
              o.import_paths = {"extra"};
              return mcpp::rules::qml::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              const auto d = deployed(r);
              c.expect(d.contains("qml/QtQuick/Controls/Basic/qmldir") && !d.contains("qml/QtQuick/Controls/Material/qmldir")
                       && !d.contains("qml/QtQuick/Controls/Fusion/qmldir"), "only the listed style is followed");
              c.expect(!d.contains("qml/QtQuick/Controls/Material/impl/qmldir"), "and what only the other styles import is not placed");
              c.expect(d.contains("qml/Acme/Gadget/qmldir") && d.contains("qml/Acme/Gadget/Gadget.qml"), "a module of import_paths is placed under qml/ by its uri");
              c.expect(!d.contains("qml/Probe/qmldir"), "the project's own module is not a Qt module");
              c.expect(r.has_line("mcpp:warning=", {"QtQuick.Nothing", "xim:qt"}), "a Qt module the SDK lacks is a warning that names the payload");
              c.expect(!r.has_line("mcpp:warning=", {"Dynamic.Thing"}) && mentions(r.errors, "Dynamic.Thing"),
                       "a module in no SDK is a note, not a warning: a program registers types at run time");
          } },

        { "qml: qt.conf is written, follows the translations directory, and yields to the project's own",
          with_probe(with_qml_sdk(t::row::linux_gcc())),
          [] {
              auto o = probe_options();
              if (!mcpp::rules::qml::compile(o)) return 1;
              o.qt.i18n.deploy_to = "i18n";
              return mcpp::rules::qml::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              c.expect(r.file("out/qml/qt.conf") == "[Paths]\nPrefix = .\nQml2Imports = qml\nTranslations = i18n\n",
                       "the second run's file names the translations directory; got:\n" + r.file("out/qml/qt.conf"));
              std::size_t placed = 0;
              for (auto const& l : r.lines) if (l.starts_with("mcpp:deploy=") && l.find("/out/qml/qt.conf\t.") != std::string::npos) ++placed;
              c.expect(placed == 2, "it is placed beside the program");
          } },

        { "qml: a project's own qt.conf is kept; write_qt_conf = false writes none",
          with_probe(with_qml_sdk(t::row::linux_gcc())).file("pkg/res/qt.conf", "[Paths]\nPrefix = x\n"),
          [] { return mcpp::rules::qml::compile(probe_options()) ? 0 : 1; },
          [](const t::result& r, t::checker& c) {
              c.expect(r.exit_code == 0, "the member succeeds");
              c.expect(r.file("out/qml/qt.conf").empty() && r.count("mcpp:deploy=") > 0, "none is written");
              c.expect(!r.has_line("mcpp:deploy=", {"out/qml/qt.conf"}), "none is placed");
              c.expect(r.has_line("mcpp:warning=", {"has its own qt.conf", "Qml2Imports"}), "the warning says what the project's file must set");
          } },

        { "qml: write_qt_conf = false, and quick_plugins adds only the directories the SDK has",
          with_probe(with_qml_sdk(t::row::linux_gcc())),
          [] {
              auto o = probe_options();
              o.write_qt_conf = false;
              o.quick_plugins = {"imageformats", "xcbglintegrations"};
              return mcpp::rules::qml::compile(o) ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.file("out/qml/qt.conf").empty() && !r.has_line("mcpp:deploy=", {"qt.conf"}), "no qt.conf");
              const auto d = deployed(r);
              c.expect(d.contains("imageformats/libqpng.so") && d.contains("platforms/libqoffscreen.so"), "the directory the SDK has is placed beside platforms/");
              c.expect(!r.has_line("mcpp:warning=", {"xcbglintegrations"}), "a directory the SDK lacks is not a warning");
          } },

        // ── compatibility ───────────────────────────────────────────────────
        { "compat: program_compilers keeps its 0.16.0 answer and says until when",
          t::row::linux_libcxx().file("llvm/bin/clang").file("llvm/bin/clang++"),
          [] {
              const auto cc = mcpp::deps::program_compilers();
              std::printf("answer=%s\n", cc.cxx.c_str());
              return cc ? 0 : 1;
          },
          [](const t::result& r, t::checker& c) {
              c.expect(r.has_line("answer=", {"llvm/bin/clang++"}), "mcpp's clang++ on the libc++ row");
              c.expect(r.has_line("mcpp:diagnostic=note", {"program_compilers is kept until 2027-03-28"}),
                       "the compatibility note is printed");
          } },
    });
}
