// Reads each file named in MCPP_READER_LIST (one path per line) and writes
// `<path>\t<name>,<name>...` to <out dir>/needed.txt, or `<path>\tERROR: ...`.
import std;
import mcpp;
import mcpp.plugins.binary;

int main() {
    mcpp::rerun_if_env_changed("MCPP_READER_LIST");
    const char* list = std::getenv("MCPP_READER_LIST");
    if (!list || !*list) return 0;
    std::ifstream in{std::filesystem::path(list)};
    std::ofstream out(std::filesystem::path(std::string(mcpp::out_dir())) / "needed.txt", std::ios::binary | std::ios::trunc);
    for (std::string line; std::getline(in, line); ) {
        if (!line.empty() && line.back() == '\r') line.pop_back();
        if (line.empty()) continue;
        const auto r = mcpp::plugins::binary::needed(std::filesystem::path(line));
        out << line << '\t';
        if (!r.ok()) { out << "ERROR: " << r.error << '\n'; continue; }
        for (std::size_t i = 0; i < r.names.size(); ++i) out << (i ? "," : "") << r.names[i];
        out << '\n';
    }
    return 0;
}
