import std;
import mcpp;
import mcpp.rules.qml;

int main() {
    namespace qml = mcpp::rules::qml;
    // The canary of CI (tests/../check-deps-and-qt.sh qml-deploy) builds once with the
    // plugin-closure workaround off, to see whether the engine has taken it over.
    mcpp::rerun_if_env_changed("MCPP_QML_PLUGIN_CLOSURE");
    const char* closure = std::getenv("MCPP_QML_PLUGIN_CLOSURE");

    qml::options o;
    o.qt.modules        = { "Core", "Gui", "Qml", "Quick" };
    o.qt.deploy_plugins = { "platforms" };
    if (closure && std::string_view(closure) == "off") o.qt.plugin_closure = false;
    o.imports      = { "QtQuick.Shapes" };
    o.import_paths = { "extra" };

    qml::qml_module app;
    app.uri     = "App";
    app.root    = "qml/App";
    app.sources = { "qml/App/*.qml" };
    o.modules = { app };
    return qml::compile(o) ? 0 : 1;
}
