import std;
import mcpp;
import mcpp.plugins;

// THE ENTRY POINTS ARE DECLARED ONCE, HERE, AND BOTH ARTEFACTS COME FROM THEM.
//
// Without this the project writes the same declarations twice: in a header for
// the island's compiler, and again in whatever the C++ side reaches them
// through. C language linkage does not mangle, so two copies that disagree are
// one symbol -- the link is clean and each side reads the arguments by its own
// ABI. Generating both from one list removes the copy that can drift.
int main() {
    const std::vector<std::string> entries{
        "int saxpy_device(float a, const float* x, const float* y, float* out, unsigned n)",
        "int scale_device(float a, float* out, unsigned n)",
    };

    mcpp::plugins::island::options opt;
    opt.module_name = "island_interface.kernels";
    opt.out_dir     = std::string(mcpp::out_dir()) + "/island";
    opt.produced_by = "the island-interface fixture";

    const auto out = mcpp::plugins::island::emit(entries, opt);
    if (!out) return 1;

    // The header goes on the include path so the island can include it, and
    // both generated files join the build.
    mcpp::include_dir(out->include_dir.c_str());
    mcpp::generated(out->interface_file.c_str());
    return 0;
}
